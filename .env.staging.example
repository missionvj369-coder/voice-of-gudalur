# =================================================================
# Voice of Gudalur — STAGING environment contract (Phase 2)
# =================================================================
# Template for the Coolify staging deployment (test.voiceofgudalur.space).
#
# THIS FILE HOLDS PLACEHOLDERS ONLY. It is committed deliberately (see
# .gitignore → `!.env.staging.example`) so the required variable set is
# reviewable in Git. Real values are entered ONLY in
# Coolify → Resource → Environment, which injects them at deploy time.
#
# NEVER put a real secret in this file. `.env*` is excluded from the Docker
# build by .dockerignore, so no value here is ever baked into the image.
#
# Read alongside docs/COOLIFY_STAGING_DEPLOYMENT.md.
#
# Legend: [REQ] must be set for the container to boot / behave correctly
#         [OPT] optional; documented default applies when unset
# =================================================================

# ── 1. Deployment identity ───────────────────────────────────────
# These are what make a deployment "staging"; everything else is shared.
[REQ] APP_ENV=staging
# ^ SERVER-side marker. Activates the staging safety boundary in
#   server/middleware/stagingGuard.ts: mutating routes that write to SHARED
#   production state return 403. Any other value (or unset) = production
#   behaviour, byte-for-byte unchanged.
[REQ] VITE_APP_ENV=staging
# ^ BUILD-TIME flag consumed by src/config/stagingMode.ts. Bakes the visible
#   orange "STAGING" banner into the bundle so the environment can never be
#   mistaken for the live petition. Must be present during `vite build`.
[REQ] NODE_ENV=production
# ^ Kept as `production` ON PURPOSE on staging: it makes session cookies
#   `Secure`, enables the Express runtime that serves `dist/`, and preserves
#   production code paths. Do NOT set this to `staging` — APP_ENV is the
#   staging marker instead (see the guard's header comment).
[REQ] APP_URL=https://test.voiceofgudalur.space
# ^ Drives the CSP self-origin. A wrong value makes the SPA load but block
#   its own assets under CSP.
[OPT] SITE_URL=https://test.voiceofgudalur.space
# ^ Base URL for OAuth redirect URIs (/api/auth/google/callback). Must be the
#   staging domain AND registered in the Google console as an authorized
#   redirect URI, or Google login fails on staging.
[REQ] PORT=3000
[OPT] SHUTDOWN_TIMEOUT_SECONDS=20
# ^ Keep BELOW the orchestrator stop timeout (compose stop_grace_period and
#   the Coolify stop timeout are both 30 s).
[OPT] MAX_IN_FLIGHT=1000
[OPT] EMERGENCY_MODE=0

# ── 2. Reverse-proxy trust ───────────────────────────────────────
# Cloudflare → Traefik → container is exactly ONE hop. If this is wrong, every
# visitor shares one rate-limit bucket and the app emits 429s under trivial
# load.
[REQ] TRUST_PROXY_HOPS=1

# ── 3. Database (CockroachDB) ────────────────────────────────────
# [BLOCKER] There is currently NO isolated staging database. Until one exists
# this MUST point at the shared production cluster — which is precisely why
# the staging guard exists. See docs/COOLIFY_STAGING_DEPLOYMENT.md §"Database".
[REQ] DATABASE_URL=postgresql://<STAGING_DB_USER>:<STAGING_DB_PASSWORD>@<STAGING_CLUSTER_HOST>:26257/<STAGING_DB_NAME>?sslmode=verify-full
[REQ] DATABASE_SSL=verify-full
[REQ] DATABASE_SSL_CA=/etc/vog/cockroach-ca.crt
# ^ Path INSIDE the container. Mount the CockroachDB Cloud CA (from the
#   cluster's "Connect" dialog) as a Coolify file-volume secret. Never commit
#   the .crt itself.
[OPT] DATABASE_POOL_MAX=10
# ^ Deliberately below production's 20: a staging container must not consume
#   the cluster's connection budget and starve live traffic.

# ── 4. Sessions & signing secrets ────────────────────────────────
# Generate each value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use DIFFERENT values from production, so a staging session or token can never
# be replayed against the live site.
[REQ] SESSION_SECRET=<48_BYTES_RANDOM_BASE64URL>
[REQ] PETITION_IDENTITY_SECRET=<48_BYTES_RANDOM_BASE64URL>
# ^ Public Name+Mobile signing fails closed with 503 if this is missing/short.
[OPT] SESSION_TTL_SECONDS=86400
[OPT] IDENTITY_HMAC_SECRET=<48_BYTES_RANDOM_BASE64URL>
[OPT] VERIFICATION_IDENTITY_SECRET=<48_BYTES_RANDOM_BASE64URL>
[OPT] VERIFICATION_IDENTITY_SECRET_ACTIVE=<48_BYTES_RANDOM_BASE64URL>

# ── 5. Security / anti-abuse ─────────────────────────────────────
# The Cloudflare Turnstile SECRET. Use a SEPARATE widget from production and
# put its site key in the staging frontend config, otherwise interstitial
# challenges fail verification.
[OPT] TURNSTILE_SECRET_KEY=<STAGING_TURNSTILE_SECRET>

# ── 6. Object storage (Storj S3) ─────────────────────────────────
# WARNING: the shared production bucket is still in use (no isolated staging
# bucket/key exists yet). Uploads enabled here write into the same bucket that
# production reads from. See the Phase 2 report's risk register.
[OPT] STORJ_ACCESS_KEY=<STAGING_STORJ_ACCESS_KEY>
[OPT] STORJ_SECRET_ACCESS_KEY=<STAGING_STORJ_SECRET_KEY>
[OPT] STORJ_BUCKET=vog
[OPT] STORJ_ENDPOINT=https://gateway.storjshare.io
[OPT] STORJ_REGION=us-east-1
[OPT] STORJ_PUBLIC_LINK_BASE=https://link.storjshare.io/raw/<ACCESS_ID>/vog
[REQ] PRESIGNED_UPLOADS=false
# ^ MUST REMAIN false on staging. The direct-upload flow (POST /api/media/presign
#   + PUT /api/media/:id/complete) is gated behind this flag and its happy path
#   has NOT been executed end-to-end, because there is no isolated staging bucket
#   to test against. Enabling it would write real objects into the shared
#   production bucket.

# ── 7. Web Push (VAPID) ──────────────────────────────────────────
# Both server-side send sites are suppressed whenever APP_ENV=staging
# (server.ts), so these values are inert on staging. Left blank deliberately.
[OPT] VITE_PUSH_PUBLIC_KEY=
[OPT] PUSH_PRIVATE_KEY=
[OPT] VAPID_EMAIL=

# ── 8. Social / verification rungs (optional) ───────────────────
# Both rungs degrade to an honest "not available on this deployment" state when
# unset, and every signature still counts. Prefer leaving them UNSET on staging
# so no real third-party account is linked from a test environment.
[OPT] GOOGLE_CLIENT_ID=
[OPT] GOOGLE_CLIENT_SECRET=
[OPT] TELEGRAM_BOT_TOKEN=
[OPT] TELEGRAM_BOT_USERNAME=

# ── 9. AI VOG ────────────────────────────────────────────────────
# Keep the LLM OFF on the 8 GB VPS; the chat endpoint calls an external model.
[OPT] AI_VOG_ENABLED=false
[OPT] VITE_AI_VOG_ENABLED=false
[OPT] AI_PROVIDER=
[OPT] AI_API_KEY=
[OPT] AI_BASE_URL=
[OPT] AI_MODEL=
[OPT] OLLAMA_URL=
[OPT] OLLAMA_MODEL=
[OPT] CAMARA_MODE=off

# ── 10. Frontend mode ────────────────────────────────────────────
[OPT] VITE_APP_MODE=full
# ^ full = complete app, petition = signing experience only.

# ── 11. Staging safety switches ──────────────────────────────────
# Read by the staging guard and scripts/exportSnapshot.ts. Both MUST stay false
# during normal staging operation; they exist only for a documented
# verification window.
[REQ] STAGING_ALLOW_WRITES=false
# ^ true = DISABLES the staging safety boundary. Only ever set if this container
#   points at an ISOLATED staging database. Inert outside staging.
[REQ] STAGING_ALLOW_SNAPSHOTS=false
# ^ true = lets `scripts/exportSnapshot.ts` rewrite dist/data/*.json on staging.
#   Only set if this container owns its own dist/ and no shared snapshot store
#   serves it.