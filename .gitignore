# VOICE OF GUDALUR — static petition page only.
#
# The repo intentionally holds one deployable static page (static-petition/)
# and nothing else. The full civic-safety app (React + Vite frontend, Express
# backend, Netlify functions, Playwright suite) has been retired, so everything
# it produced is ignored here and must never come back into version control.

# ── Node / build tooling ───────────────────────────────────────
node_modules/
.npm/
.yarn/
.pnpm-store/
package-lock.json

# ── Build output ───────────────────────────────────────────────
dist/
build/
.vite/
*.tsbuildinfo
_vite.log
*.log

# ── Test artifacts ─────────────────────────────────────────────
test-results/
playwright-report/
blob-report/
coverage/
.nyc_output/

# ── Secrets — never commit ─────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Deploy / host state ────────────────────────────────────────
# Local Netlify CLI state (site links, built function bundles, plugins).
.netlify/

# ── Editor / OS cruft ──────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Scratch files from local inspection ────────────────────────
tmp_*.txt
