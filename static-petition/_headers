# Voice of Gudalur — petition site caching rules.
#
# Cloudflare Pages and Netlify both read this `_headers` file from the publish
# directory; other hosts ignore it.
#
# WHY index.html must never be cached hard: the page is shared by link over
# WhatsApp / Instagram, whose in-app browsers cache aggressively. If the HTML is
# cached, visitors keep seeing the stale page after a redeploy. Revalidate every
# time; the page is ~24 KB and brotli-compresses to ~6 KB.

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Explicit charset for HTML files — without this, Cloudflare/Netlify serve
# text/html without a charset directive, so browsers fall back to ISO-8859-1
# and the UTF-8 em-dashes, curly quotes and Tamil/Malayalam/Kannada glyphs
# turn into mojibake (e.g. " â€" " instead of " — ").
/*.html
  Content-Type: text/html; charset=utf-8

/*.htm
  Content-Type: text/html; charset=utf-8

# The hero film, its poster frame, the logo, the background song and the
# self-hosted font subsets. None of these are content-hashed, so keep the TTL
# short enough that a re-encoded asset is picked up within a day, with a long
# stale-while-revalidate tail so the swap never costs the visitor a wait.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The campaign song. The Content-Type is stated rather than assumed, for exactly
# the reason it is stated on /docs/* below: with X-Content-Type-Options: nosniff
# in force, a host that answered an .m4a with application/octet-stream makes the
# browser download the file instead of playing it - and since the song starts
# on its own as soon as the page opens, that failure would land as a silent
# page rather than a wrong header.
/media/gudalur-new-path.m4a
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Content-Type: audio/mp4

/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The two grievance record pages, and the shared first-party assets they and the
# homepage load. Same reasoning as /index.html applies: these pages are shared
# over WhatsApp and Instagram, whose in-app browsers cache HTML aggressively,
# and a stale copy of a grievance record is worse than a slow one.
/grievances/*
  Cache-Control: public, max-age=0, must-revalidate

# The shared CSS/JS. Every page references these with a ?v=N fingerprint, and N
# is bumped on every deploy, so the URL of a changed file is a URL no browser
# has ever seen. That is what makes a year-long immutable TTL safe: nothing is
# ever served stale, because nothing stale is ever requested. It is also the
# single biggest lever this site has under a crowd - the stylesheet, the copy
# table and the support script are fetched from the edge once per visitor
# instead of revalidated on every navigation.
#
# The ?v= lives in the query string, so it is part of the cache key the CDN
# computes; `immutable` tells the browser never to ask again for that key.
#
# Bump the ?v= on vog.css, vog-i18n.js and vog-support.js together in all three
# pages whenever any of them changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The three published PDFs (the government reply, our appeal, and the
# Gudalur Transformation Plan). Browsers hand these to the built-in PDF viewer
# rather than rendering them, so there is nothing here to cache aggressively;
# one day covers a corrected upload without making a reader wait on a re-upload.
#
# The Content-Type is stated rather than assumed. Each document is offered
# twice - "Read" opens it in the reader's own PDF viewer, "Download" saves it -
# and the two only differ by that: no `download` attribute on Read, one on
# Download. With `X-Content-Type-Options: nosniff` in force below, a host that
# answered with application/octet-stream would make the browser download the
# file instead of showing it, and Read would become a second Download button.
# Netlify and Cloudflare both resolve .pdf to application/pdf on their own;
# this line is what keeps that true on any host, and matches what the local
# preview server is told to send.
/docs/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Content-Type: application/pdf

# ─── Security headers ────────────────────────────────────────────────────────
# The page is first-party by design: no third-party script, no iframe, no remote
# font, and no network request of any kind beyond its own files. Every official
# follow-up route (tel:1100, the CM Helpline mailbox, the Mudhalvarin Mugavari
# portal) is a plain <a href>, which CSP does not restrict, so form-action stays
# 'self' and frame-src and object-src stay closed.
#
# script-src carries NO 'unsafe-inline'. There is exactly one inline script on
# the whole site - the three-line reveal fallback in the <head> that sets the
# .js class - and it is byte-identical on all three pages, so one SHA-256 covers
# every page. tools/csp-hash.mjs recomputes it from the shipped HTML and fails if
# _headers disagrees; tools/inline-snippet.ps1 rewrites the tag in every page and
# prints the new hash after an edit. Because .rv is only ever hidden under .js,
# and .js is only ever set by that script, a hash that fails to match costs the
# reveal animation and nothing else: the page is fully visible without it.
#
# style-src still needs 'unsafe-inline': three elements carry a one-off inline
# style, and unpicking them for no security gain would be theatre.
#
# Everything this petition does not use is switched off outright rather than left
# for a future feature request to re-open. autoplay is deliberately absent from
# that list: denying it would silence the intro film's song.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), battery=(), camera=(), display-capture=(), document-domain=(), encrypted-media=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), web-share=(), xr-spatial-tracking=()
  X-Permitted-Cross-Domain-Policies: none
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-eeubnwpLblNMPe6+H2mXRG3JyGSv0f9zNEhGsWtqSTc='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
