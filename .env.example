# =================================================================
# Voice of Gudalur — Environment Contract (CockroachDB architecture)
# =================================================================
# Copy to `.env` for local dev. NEVER commit `.env`.
# Server-only secrets have NO VITE_ prefix — the browser never sees them.

# ── CockroachDB (server-only) ─────────────────────────────────────
# CockroachDB Cloud (serverless/dedicated) example:
#   postgresql://<user>:<password>@<cluster-host>:26257/<database>?sslmode=verify-full
DATABASE_URL=
# TLS mode: verify-full (recommended) | require | none
DATABASE_SSL=verify-full
# Path to the cluster CA certificate (.crt) — download from the CockroachDB
# Cloud "Connect" dialog. Required for true verify-full verification.
DATABASE_SSL_CA=
# Max pooled connections (server-side; the browser NEVER connects to the DB)
DATABASE_POOL_MAX=20

# ── Sessions & auth (server-only) ─────────────────────────────────
# Long random string (32+ bytes) used to sign access-token JWTs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_SECONDS=86400
# OTP delivery: devel = 6-digit code printed to the server console and
# returned to the client for dev/test. sms = real provider (configure SMS_*).
# NEVER ship OTP_PROVIDER=devel to production.
OTP_PROVIDER=devel

# ── SMS provider (only when OTP_PROVIDER=sms) ─────────────────────
# No credentials are invented — if sms is selected without keys, OTP send
# fails loudly. Wire the provider of your choice in server/services/authService.ts.
SMS_PROVIDER=
SMS_FROM=
SMS_API_KEY=
SMS_API_SECRET=

# ── Self-hosted Web Push (VAPID) ─────────────────────────────────
# Generate once: npx web-push generate-vapid-keys
VITE_PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
VAPID_EMAIL=

# ── Storj S3-compatible object storage (media files) ─────────────
# Files → Storj via presigned PUT; only the permanent public URL is stored
# in CockroachDB. Media never transits the API server.
# 1. Create a project + bucket: https://tardigrade.io
# 2. Access → Create Access → S3 Gateway credential.
# 3. Objects → bucket → "Create Public Access Link"; set STORJ_PUBLIC_LINK_BASE
#    to the generated prefix, e.g. https://link.storjshare.io/raw/<access-id>
STORJ_ACCESS_KEY=
STORJ_SECRET_ACCESS_KEY=
STORJ_PUBLIC_LINK_BASE=
STORJ_BUCKET=voice-of-gudalur
STORJ_ENDPOINT=https://gateway.storjshare.io
STORJ_REGION=us-east-1

# ── Application ──────────────────────────────────────────────────
APP_URL=https://voiceofgudalur.space
PORT=3000
NODE_ENV=

# ── Optional: self-hosted AI (100% open-source, no API keys) ─────
# Chat: any OpenAI-compatible local LLM (Ollama, MIT). Speech: self-hosted
# Whisper (Speaches/faster-whisper, Apache-2.0). Browsers transcribe
# on-device via Transformers.js — the server fallback is optional.
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2
WHISPER_URL=
WHISPER_MODEL=whisper-small
# Aadhaar QR decode (offline Python service, returns last-4 only)
PYTHON_BIN=python
