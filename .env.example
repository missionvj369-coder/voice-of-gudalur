# ================= SUPABASE (required) =================
# Your Supabase project is already configured:
#   VITE_SUPABASE_URL=https://wxzhgcekzcrmqrcnhqwv.supabase.co
#   VITE_SUPABASE_ANON_KEY=<your-anon-key>
#
# 1. Run supabase/GO_LIVE_SCHEMA.sql in the Supabase SQL Editor
#    (single consolidated, idempotent file — creates all tables + functions).
# 2. Set the values below from your Supabase project settings.
VITE_SUPABASE_URL="https://wxzhgcekzcrmqrcnhqwv.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# NOTE: AI transcription is 100% open-source and key-free:
#   1. On-device Whisper (transformers.js, Apache-2.0) — runs in the browser,
#      no API key, audio never leaves the phone, works offline after first load.
#   2. Optional server fallback: set WHISPER_URL to a self-hosted
#      faster-whisper / Speaches endpoint (also open-source).

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://voiceofgudalur.space"

# --- WhatsApp Voice Intake (netlify/functions/webhook.js) ---
WHATSAPP_VERIFY_TOKEN=my_secret_token_123
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GROQ_API_KEY=
# Server-side Supabase (service_role key - NEVER expose in the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Self-Hosted Web Push (generated via `npx web-push generate`) ---
VITE_PUSH_PUBLIC_KEY=BM-your-generated-public-key-here
PUSH_PRIVATE_KEY=your-generated-private-key-here
VAPID_EMAIL=gudalur-voice@your-domain.org
# ============ STORJ OBJECT STORAGE (S3-compatible — Voice Board + Sighting media) ============
# Storj free tier: 25 GB storage + 25 GB egress/month (S3-compatible, decentralized).
# 1. Create a project + bucket in the Storj web console:  https://tardigrade.io
# 2. Access -> Create Access -> S3 Gateway credential (gives Access Key + Secret Key).
# 3. Objects -> your bucket -> "Create Public Access Link" for the media prefixes.
#    Set STORJ_PUBLIC_LINK_BASE to the generated prefix (minus bucket/key), e.g.:
#    https://link.storjshare.io/raw/<access-id>
# 4. Run supabase/PLATFORM_ENHANCEMENTS.sql in Supabase SQL Editor.
STORJ_ACCESS_KEY="<your-storj-access-key>"
STORJ_SECRET_ACCESS_KEY="<your-storj-secret-access-key>"
STORJ_PUBLIC_LINK_BASE="<your-public-access-link-prefix>"
STORJ_BUCKET="voice-of-gudalur"
# Optional overrides (defaults match Storj — https://gateway.storjshare.io, region us-east-1):
# STORJ_ENDPOINT="https://gateway.storjshare.io"
# STORJ_REGION="us-east-1"
