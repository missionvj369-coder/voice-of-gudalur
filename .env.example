# =================================================================
# Voice of Gudalur — Environment Contract (CockroachDB architecture)
# =================================================================
# Copy to `.env` for local dev. NEVER commit `.env`.
# Server-only secrets have NO VITE_ prefix — the browser never sees them.

# ── CockroachDB (server-only) ─────────────────────────────────────
# CockroachDB Cloud (serverless/dedicated) example:
#   postgresql://<user>:<password>@<cluster-host>:26257/<database>?sslmode=verify-full
DATABASE_URL=
# TLS mode: verify-full (recommended) | require | none
DATABASE_SSL=verify-full
# Path to the cluster CA certificate (.crt) — download from the CockroachDB
# Cloud "Connect" dialog. Required for true verify-full verification.
DATABASE_SSL_CA=
# Max pooled connections (server-side; the browser NEVER connects to the DB)
DATABASE_POOL_MAX=20

# ── Sessions & auth (server-only) ─────────────────────────────────
# Long random string (32+ bytes) used to sign access-token JWTs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_SECONDS=86400
# OTP delivery: devel = 6-digit code printed to the server console and
# returned to the client for dev/test. sms = real provider (configure SMS_*).
# NEVER ship OTP_PROVIDER=devel to production.
OTP_PROVIDER=devel

# ── SMS provider (real OTP delivery when OTP_PROVIDER != devel) ────────────
# India-first: TRAI/DLT rules apply for transactional SMS to Indian numbers.
#   • fast2sms — easiest start: https://www.fast2sms.com → "Dev API" key.
#       The `otp` route uses Fast2SMS's own DLT-approved template (no setup).
#       Required: SMS_API_KEY  (their "authorization" key)
#   • msg91 — https://msg91.com — needs your own DLT-approved OTP template.
#       Required: SMS_API_KEY (authkey) + SMS_TEMPLATE_ID (flow template id;
#       the template must contain the variable {{OTP}})
#   • twilio — international; costly for India + DLT registration required.
#       Required: SMS_API_KEY (Account SID), SMS_API_SECRET (auth token),
#                 SMS_FROM (E.164 sender, e.g. +91XXXXXXXXXX)
SMS_PROVIDER=fast2sms
SMS_API_KEY=
SMS_API_SECRET=
SMS_TEMPLATE_ID=
SMS_FROM=

# ── Self-hosted Web Push (VAPID) ─────────────────────────────────
# Generate once: npx web-push generate-vapid-keys
VITE_PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
VAPID_EMAIL=

# ── Storj S3-compatible object storage (media files) ─────────────
# Files → Storj via presigned PUT; only the permanent public URL is stored
# in CockroachDB. Media never transits the API server.
# 1. Create a project + bucket: https://tardigrade.io
# 2. Access → Create Access → S3 Gateway credential.
# 3. Objects → bucket → "Create Public Access Link"; set STORJ_PUBLIC_LINK_BASE
#    to the generated prefix, e.g. https://link.storjshare.io/raw/<access-id>
STORJ_ACCESS_KEY=
STORJ_SECRET_ACCESS_KEY=
STORJ_PUBLIC_LINK_BASE=https://link.storjshare.io/raw/jwx5xkbqglx4xwwvgp2wdc3ipiwa/vog
STORJ_BUCKET=vog
STORJ_ENDPOINT=https://gateway.storjshare.io
STORJ_REGION=us-east-1

# ── Application ──────────────────────────────────────────────────
APP_URL=https://voiceofgudalur.space
PORT=3000
NODE_ENV=

# ── Emergency mode (Phase 27) ───────────────────────────────────
# Set to 1 to shed non-essential endpoints during extreme load.
# Essential endpoints (auth, petitions, media, health) remain active.
EMERGENCY_MODE=0

# ── Load shedding (Phase 28) ────────────────────────────────────
# Maximum concurrent in-flight requests per function instance.
# When exceeded, new requests receive a 503 with Retry-After.
MAX_IN_FLIGHT=150

# ── Petition-only launch (public Name+Mobile signing) ───────────
# REQUIRED in production. Server-only secret (32+ chars of entropy) used for:
#   1. mobile_identity_hash = HMAC-SHA-256(secret, normalized 10-digit mobile)
#      → the protected uniqueness key in petition_mobile_signs (migration 016).
#      The raw mobile is NEVER stored — only this HMAC and phone_last4.
#   2. HMAC-signing the public anti-bot challenge (/api/petition/challenge).
# MISSING OR SHORT = public signing fails closed with 503 (deliberate).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PETITION_IDENTITY_SECRET=

# ── AI VOG flag (petition-only launch) ──────────────────────────
# Set to false to switch every /api/ai/* endpoint off with a stable 503
# (zero LLM/API spend; petition signing NEVER depends on AI). The AI code
# stays in the codebase — remove the flag to reactivate.
AI_VOG_ENABLED=true

# ── Frontend production mode (Vite — safe to expose) ────────────
# petition = production shows ONLY the petition-signing experience
#            (nav, login/register, wildlife, AI VOG all hidden — not deleted)
# full     = complete app (future reactivation; current default)
VITE_APP_MODE=petition
# Frontend AI VOG greeter flag (AIPresenter). false = never mounts.
VITE_AI_VOG_ENABLED=false

# ── Optional: self-hosted AI (100% open-source, no API keys) ─────
# Chat: any OpenAI-compatible local LLM (Ollama, MIT). Speech: self-hosted
# Whisper (Speaches/faster-whisper, Apache-2.0). Browsers transcribe
# on-device via Transformers.js — the server fallback is optional.
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2
WHISPER_URL=
WHISPER_MODEL=whisper-small
# Aadhaar QR decode (offline Python service, returns last-4 only)
PYTHON_BIN=python
