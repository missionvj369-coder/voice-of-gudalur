ignore-scripts=false
# Netlify runs builds with NODE_ENV=production by default, which causes npm
# to SKIP devDependencies. But the Netlify Function bundler (esbuild) needs
# devDependencies like @types/*, vite (for the SPA build), and tsx (for the
# function transpilation) to be present. Force npm to install EVERYTHING.
# This is the fix for the "vite: not found" build error and the
# "OFFLINE-{timestamp}" Gudalur IDs created when /api/* routes 502.
legacy-peer-deps=true
