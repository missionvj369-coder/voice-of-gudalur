{
  "entities": {
    "UserProfile": {
      "title": "Resident User Profile",
      "description": "Resident profile with Gudalur ID, verified locality and civic role",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "localityId": { "type": "string" },
        "localityName": { "type": "string" },
        "gudalurId": { "type": "string" },
        "role": { "type": "string", "enum": ["RESIDENT", "LOCAL_MEMBER", "LOCAL_MODERATOR", "LOCAL_ADMIN", "CORE_ADMIN", "VERIFIER", "PLATFORM_ADMIN"] },
        "verificationLevel": { "type": "string", "enum": ["REGISTERED", "PHONE_VERIFIED", "LOCALITY_VERIFIED", "TRUSTED_MEMBER", "LOCAL_ADMIN", "CORE_ADMIN", "PLATFORM_ADMIN"] },
        "isBloodDonor": { "type": "boolean" },
        "bloodGroup": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "bio": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "name", "localityId", "gudalurId", "role", "verificationLevel"]
    },
    "CivicIssue": {
      "title": "Civic Issue Report",
      "description": "Citizen logged civic issue with tracking ID and lifecycle timeline",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "photoUrl": { "type": "string" },
        "localityId": { "type": "string" },
        "localityName": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "address": { "type": "string" },
        "reporterId": { "type": "string" },
        "reporterName": { "type": "string" },
        "reporterGudalurId": { "type": "string" },
        "status": { "type": "string", "enum": ["REPORTED", "RECEIVED", "VERIFICATION", "ASSIGNED", "ACTION", "OFFICIAL_RESPONSE", "COMMUNITY_REVIEW", "RESOLVED"] },
        "assignedAuthority": { "type": "string" },
        "officialGrievanceId": { "type": "string" },
        "upvotesCount": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["title", "category", "localityId", "reporterId", "status"]
    },
    "UrgentAlert": {
      "title": "Urgent Alert Broadcast",
      "description": "Verified critical alerts for wildlife, roads, and emergencies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "titleTa": { "type": "string" },
        "description": { "type": "string" },
        "descriptionTa": { "type": "string" },
        "category": { "type": "string" },
        "severity": { "type": "string", "enum": ["INFO", "NOTICE", "WARNING", "URGENT", "CRITICAL"] },
        "source": { "type": "string" },
        "verificationStatus": { "type": "string", "enum": ["OFFICIAL", "VERIFIED_COMMUNITY", "UNVERIFIED_REPORT"] },
        "createdBy": { "type": "string" },
        "verifiedBy": { "type": "string" },
        "createdAt": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["title", "category", "severity", "source", "active"]
    },
    "WildlifeIncident": {
      "title": "Wildlife Incident Report",
      "description": "Elephant sighting or human-wildlife safety record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "localityId": { "type": "string" },
        "localityName": { "type": "string" },
        "generalizedArea": { "type": "string" },
        "herdSize": { "type": "number" },
        "behavior": { "type": "string" },
        "urgency": { "type": "string" },
        "reportedBy": { "type": "string" },
        "verifiedByForestDept": { "type": "boolean" },
        "timestamp": { "type": "number" }
      },
      "required": ["type", "localityId", "generalizedArea", "timestamp"]
    },
    "Petition": {
      "title": "Collective Civic Petition",
      "description": "Evidence-driven citizen demand with verified support count",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "titleTa": { "type": "string" },
        "problem": { "type": "string" },
        "demand": { "type": "string" },
        "targetAuthority": { "type": "string" },
        "evidenceSummary": { "type": "string" },
        "supportCount": { "type": "number" },
        "status": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "problem", "demand", "targetAuthority", "supportCount", "status"]
    },
    "UserGrievanceRecord": {
      "title": "Government Grievance Record",
      "description": "Citizen tracking record for official government petition IDs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userGudalurId": { "type": "string" },
        "authority": { "type": "string" },
        "complaintId": { "type": "string" },
        "title": { "type": "string" },
        "submissionDate": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["userId", "authority", "complaintId", "title", "status"]
    },
    "ServiceListing": {
      "title": "Local Service Directory Listing",
      "description": "Verified essential service provider and emergency listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "phone": { "type": "string" },
        "localityId": { "type": "string" },
        "localityName": { "type": "string" },
        "description": { "type": "string" },
        "address": { "type": "string" },
        "is24x7": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "category", "phone", "localityId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Resident user profiles"
    },
    "/civic_issues/{issueId}": {
      "schema": "CivicIssue",
      "description": "Citizen reported civic issues"
    },
    "/alerts/{alertId}": {
      "schema": "UrgentAlert",
      "description": "Urgent broadcast alerts"
    },
    "/wildlife_incidents/{incidentId}": {
      "schema": "WildlifeIncident",
      "description": "Wildlife sightings and conflict logs"
    },
    "/petitions/{petitionId}": {
      "schema": "Petition",
      "description": "Collective civic petitions"
    },
    "/government_grievances/{grievanceId}": {
      "schema": "UserGrievanceRecord",
      "description": "Official government complaint tracking records"
    },
    "/services/{serviceId}": {
      "schema": "ServiceListing",
      "description": "Services and emergency helpline directory"
    }
  }
}
