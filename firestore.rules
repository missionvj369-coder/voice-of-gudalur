rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'vijaybalakrishnanshanmugam@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['PLATFORM_ADMIN', 'CORE_ADMIN', 'admin'])
      ); 
    }

    // Resident Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'localityId', 'localityName', 'isBloodDonor', 'bloodGroup', 'avatarUrl', 'bio', 'updatedAt']))
      );
    }

    // Civic Issues Collection
    match /civic_issues/{issueId} {
      allow read: if true; // Public civic transparency
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() || 
        (existing().reporterId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'photoUrl', 'updatedAt'])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['upvotesCount', 'upvotedBy', 'updatedAt'])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'assignedAuthority', 'officialGrievanceId', 'timeline', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }

    // Urgent Alerts Collection
    match /alerts/{alertId} {
      allow read: if true; // Public emergency safety
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    // Wildlife Incidents Collection
    match /wildlife_incidents/{incidentId} {
      allow read: if true; // Public safety & coexistence
      allow create: if isSignedIn() || true;
      allow update, delete: if isAdmin() || (isSignedIn() && existing().reportedBy == request.auth.uid);
    }

    // Petitions / Act for Gudalur Collection
    match /petitions/{petitionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['supportCount', 'supporters'])) ||
        (existing().createdBy == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // Government Grievance Records Collection
    match /government_grievances/{grievanceId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Essential Services & Directory Collection
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Discussion Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }
  }
}
